# Database Configuration
DB_HOST=oracle-db
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USER=committed_user
DB_PASSWORD=SecurePassword123!
ORACLE_PASSWORD=OracleAdminPass123!

# Gateway Service (Java Spring Boot)
GATEWAY_PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-256-bits
JWT_EXPIRATION=86400000

# Core Service (PHP Symfony)
CORE_PORT=8000
APP_ENV=dev
APP_SECRET=symfony-secret-key-change-this

# Code Analyzer Service (Python Flask)
ANALYZER_PORT=5000
OPENAI_API_KEY=sk-your-openai-api-key-here
TEMP_CLONE_DIR=/tmp/code-analysis

# Notification Service (.NET Core)
NOTIFICATION_PORT=5001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@commit-ed.com
FROM_NAME=CommitEd Platform

# Web Frontend (React)
VITE_API_URL=http://localhost/api

# Nginx
NGINX_PORT=80
