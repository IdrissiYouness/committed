# ============================================================================
# Committed Platform - Environment Variables
# Copy this file to .env and update the values
# ============================================================================

# PostgreSQL Database (shared by all services)
POSTGRES_DB=committed_core
POSTGRES_USER=core_user
POSTGRES_PASSWORD=CoreSecurePass123!
POSTGRES_PORT=5432

# Gateway Service (Java Spring Boot)
GATEWAY_PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-256-bits
JWT_EXPIRATION=86400000

# Core Service (PHP Symfony)
CORE_PORT=8000
APP_ENV=dev
APP_SECRET=symfony-secret-key-change-this

# Code Analyzer Service (Python Flask + Kilo Code CLI)
ANALYZER_PORT=5000
TEMP_CLONE_DIR=/tmp/code-analysis
# Number of concurrent analyses the background thread pool can run simultaneously.
ANALYZER_MAX_WORKERS=4
# Seconds to wait when POSTing the analysis result back to the gateway callback.
ANALYZER_CALLBACK_TIMEOUT=10
# Gateway endpoint that receives the analysis result when a job completes.
GATEWAY_CALLBACK_URL=http://gateway:8080/internal/analysis-result
# Base64-encoded Kilo Code auth.json (GitHub Copilot OAuth tokens).
# Generate once with: base64 -w 0 ~/.local/share/kilo/auth.json
# Then share the value with your team via a password manager / secrets vault.
KILO_AUTH_JSON_B64=

# Notification Service (.NET Core)
# SMTP_USER and FROM_EMAIL must be the same Gmail address.
# SMTP_PASSWORD is a Gmail App Password (not your regular password).
# Generate one at: https://myaccount.google.com/apppasswords (requires 2FA)
NOTIFICATION_PORT=5001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Committed Platform

# Web Frontend (React)
VITE_API_URL=http://localhost/api

# Nginx
NGINX_PORT=80
