    {
      "name": "4 — Change Password",
      "description": "Change the authenticated user's password. Requires the current password for verification. Returns fresh tokens on success.",
      "item": [
        {
          "name": "4.1 Change Password — 200 OK + New Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is successful', () => {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Fresh tokens returned', () => {",
                  "    const tokens = pm.response.json().data;",
                  "    pm.expect(tokens.accessToken).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(tokens.refreshToken).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(tokens.tokenType).to.equal('Bearer');",
                  "    // Store new tokens — old ones are now stale",
                  "    pm.collectionVariables.set('access_token', tokens.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', tokens.refreshToken);",
                  "    // Track the new password for subsequent tests",
                  "    pm.collectionVariables.set('test_password', pm.collectionVariables.get('changed_password'));",
                  "    console.log('Password changed — new tokens stored');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{test_password}}\",\n  \"newPassword\": \"{{changed_password}}\"\n}"
            },
            "url": {
