    {
      "name": "3 — PUT Profile",
      "description": "Update the authenticated user's profile. At least one of fullName or email must be supplied.",
      "item": [
        {
          "name": "3.1 Update fullName Only — 200 OK + New Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is successful', () => {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Profile fullName is updated', () => {",
                  "    const profile = pm.response.json().data.profile;",
                  "    pm.expect(profile.fullName).to.equal('Updated Full Name');",
                  "});",
                  "",
                  "pm.test('Email is unchanged', () => {",
                  "    const profile = pm.response.json().data.profile;",
                  "    pm.expect(profile.email).to.equal(pm.collectionVariables.get('test_email'));",
                  "});",
                  "",
                  "pm.test('New tokens returned (fullName is in JWT claims)', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.tokens).to.be.an('object');",
                  "    pm.expect(body.data.tokens.accessToken).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(body.data.tokens.refreshToken).to.be.a('string').and.not.be.empty;",
                  "    // Store the new tokens",
                  "    pm.collectionVariables.set('access_token', body.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', body.data.tokens.refreshToken);",
                  "    console.log('Tokens updated after fullName change');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Full Name\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/users/profile",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "Update only fullName. Since fullName is embedded in JWT claims, new tokens are returned."
          }
        },
        {
          "name": "3.2 Update Email Only — 200 OK + New Tokens",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Build a new unique email for the update",
                  "const ts = Date.now();",
                  "const newEmail = `profile_updated_${ts}@example.com`;",
                  "pm.collectionVariables.set('updated_email', newEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Profile email is updated', () => {",
                  "    const profile = pm.response.json().data.profile;",
                  "    pm.expect(profile.email).to.equal(pm.collectionVariables.get('updated_email'));",
                  "    // Keep test_email in sync so login tests still work",
                  "    pm.collectionVariables.set('test_email', profile.email);",
                  "});",
                  "",
                  "pm.test('New tokens returned (email is in JWT claims)', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.tokens).to.be.an('object');",
                  "    pm.expect(body.data.tokens.accessToken).to.be.a('string').and.not.be.empty;",
                  "    pm.collectionVariables.set('access_token', body.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', body.data.tokens.refreshToken);",
                  "    console.log('Tokens updated after email change — new email:', pm.collectionVariables.get('test_email'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{updated_email}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/users/profile",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "Update only email. Since email is the JWT subject claim, new tokens are returned.\nThe pre-request script generates a unique email to avoid conflicts."
          }
        },
        {
          "name": "3.3 Update Both fullName + Email — 200 OK",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "const newEmail = `profile_both_${ts}@example.com`;",
                  "pm.collectionVariables.set('updated_email', newEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Both fields updated', () => {",
                  "    const profile = pm.response.json().data.profile;",
                  "    pm.expect(profile.fullName).to.equal('Both Fields Updated');",
                  "    pm.expect(profile.email).to.equal(pm.collectionVariables.get('updated_email'));",
                  "    pm.collectionVariables.set('test_email', profile.email);",
                  "});",
                  "",
                  "pm.test('New tokens returned', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.tokens).to.be.an('object');",
                  "    pm.collectionVariables.set('access_token', body.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', body.data.tokens.refreshToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Both Fields Updated\",\n  \"email\": \"{{updated_email}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/users/profile",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "Update both fullName and email in a single request."
          }
        },
