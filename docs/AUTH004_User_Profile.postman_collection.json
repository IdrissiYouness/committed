{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "AUTH-004 — User Profile Management",
    "description": "Dedicated test collection for AUTH-004: User Profile Management.\n\n## Prerequisites\n1. Docker containers must be running: `docker compose up --build postgres-db gateway core -d`\n2. Run **Setup: Register + Login** first to populate `access_token`, `refresh_token`, and `user_id` variables.\n3. All profile endpoints require a valid JWT in the `access_token` variable.\n\n## Flow\n1. Setup — Register a fresh test user and log in to get tokens\n2. GET Profile — retrieve the authenticated user's profile\n3. PUT Profile — update fullName and/or email\n4. Change Password — verify old password then set a new one\n5. Edge Cases — validation errors, wrong password, missing fields\n\n## Services\n- **Gateway** (Java Spring Boot) — `http://localhost:8080` — auth, JWT, routing\n- **Core** (PHP Symfony) — `http://localhost:8000` — user persistence (internal only)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token — populated automatically by Setup requests"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string",
      "description": "JWT refresh token — populated automatically by Setup requests"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string",
      "description": "Authenticated user ID — populated automatically by Setup requests"
    },
    {
      "key": "test_email",
      "value": "",
      "type": "string",
      "description": "Email used for the test user — set by the register request"
    },
    {
      "key": "test_password",
      "value": "Password123!",
      "type": "string",
      "description": "Password for the test user (keep in sync with the register body)"
    },
    {
      "key": "changed_password",
      "value": "NewPassword456!",
      "type": "string",
      "description": "Password after change-password succeeds — used in subsequent re-login tests"
    }
  ],
  "item": [
    {
      "name": "1 — Setup: Register + Login",
      "description": "Create a brand-new test user and log in to populate access_token, refresh_token, and user_id. Run these two requests in order before running any other folder.",
      "item": [
        {
          "name": "1.1 Register Test User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a unique email so re-runs don't cause 409 conflicts",
                  "const ts = Date.now();",
                  "const email = `profile_test_${ts}@example.com`;",
                  "pm.collectionVariables.set('test_email', email);",
                  "pm.collectionVariables.set('test_password', 'Password123!');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has success flag', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Access token present', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.accessToken).to.be.a('string').and.not.be.empty;",
                  "    pm.collectionVariables.set('access_token', body.data.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', body.data.refreshToken);",
                  "    pm.collectionVariables.set('user_id', String(body.data.user.userId));",
                  "    console.log('Test user registered — userId:', body.data.user.userId);",
                  "    console.log('Test email:', pm.collectionVariables.get('test_email'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"fullName\": \"Profile Test User\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a fresh user with a timestamped email to avoid 409 conflicts on re-runs.\nStores access_token, refresh_token, user_id, and test_email as collection variables."
          }
        },
        {
          "name": "1.2 Login Test User (verify tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Login returns tokens', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "    pm.expect(body.data.accessToken).to.be.a('string').and.not.be.empty;",
                  "    // Re-set tokens from login (ensures we always have a fresh pair)",
                  "    pm.collectionVariables.set('access_token', body.data.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', body.data.refreshToken);",
                  "    console.log('Login successful — tokens refreshed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Log in with the test user created in 1.1 to confirm credentials work and refresh the stored tokens."
          }
        }
      ]
    },
    {
      "name": "2 — GET Profile",
      "description": "Retrieve the authenticated user's public profile. Requires a valid access_token.",
      "item": [
        {
          "name": "2.1 Get My Profile — 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success flag', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Profile contains expected fields', () => {",
                  "    const profile = pm.response.json().data;",
                  "    pm.expect(profile.userId).to.be.a('number');",
                  "    pm.expect(profile.email).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(profile.fullName).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(profile.systemRole).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(profile.isActive).to.be.a('boolean');",
                  "    pm.expect(profile.createdAt).to.be.a('string');",
                  "    pm.expect(profile.updatedAt).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Profile does NOT expose passwordHash', () => {",
                  "    const profile = pm.response.json().data;",
                  "    pm.expect(profile.passwordHash).to.be.undefined;",
                  "});",
                  "",
                  "pm.test('Profile email matches test email', () => {",
                  "    const profile = pm.response.json().data;",
                  "    pm.expect(profile.email).to.equal(pm.collectionVariables.get('test_email'));",
                  "});",
                  "",
                  "pm.test('Profile userId matches stored user_id', () => {",
                  "    const profile = pm.response.json().data;",
                  "    pm.expect(String(profile.userId)).to.equal(pm.collectionVariables.get('user_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/users/profile",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "Happy path: fetch the authenticated user's profile.\nExpects userId, email, fullName, systemRole, isActive, createdAt, updatedAt — no passwordHash."
          }
        },
        {
          "name": "2.2 Get Profile — 401 No Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/users/profile",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "No Authorization header — expect 401 Unauthorized."
          }
        },
        {
          "name": "2.3 Get Profile — 401 Malformed Token",
          "event": [
