# Code Analyzer Service — Configuration Template
# Copy to .env and edit before running locally.

# ── Directories ───────────────────────────────────────────────────────────────
TEMP_DIR=/tmp/code-analysis
REPORTS_DIR=/tmp/reports

# ── External tools ────────────────────────────────────────────────────────────
# Path to the Typst binary (PDF compiler)
TYPST_BIN=/usr/local/bin/typst

# Kilo Code CLI command
AGENT_CLI=kilo

# Which runner to use: "kilo" (default) or "mock" (tests / CI without Kilo)
AGENT_RUNNER=kilo

# Base64-encoded Kilo Code auth.json (GitHub Copilot OAuth tokens).
# Used by entrypoint.sh to write /root/.local/share/kilo/auth.json at startup.
# Generate with: base64 -w 0 ~/.local/share/kilo/auth.json
# Get this value from your team's password manager — never commit the real value.
KILO_AUTH_JSON_B64=

# ── Git settings ──────────────────────────────────────────────────────────────
# Shallow clone depth — enough history for commit hygiene analysis
CLONE_DEPTH=50

# Comma-separated URL prefixes that are accepted as repository hosts.
# Add self-hosted Gitea/Bitbucket entries here if needed.
ALLOWED_HOSTS=https://github.com/,https://gitlab.com/

# ── Timeout settings (seconds) ────────────────────────────────────────────────
CLONE_TIMEOUT=120
AGENT_TIMEOUT=300

# ── Flask settings ────────────────────────────────────────────────────────────
PORT=5000
# Never set to true in production — exposes the Werkzeug debugger
FLASK_DEBUG=false

# ── Notification service ──────────────────────────────────────────────────────
NOTIFICATION_SERVICE_URL=http://notifications:5001

# ── Async job queue ───────────────────────────────────────────────────────────
# Number of concurrent analyses the background thread pool can run simultaneously.
MAX_WORKERS=4
# Seconds to wait when POSTing the analysis result back to the gateway callback.
CALLBACK_TIMEOUT=10
# Gateway endpoint that receives the analysis result when a job completes.
GATEWAY_CALLBACK_URL=http://gateway:8080/internal/analysis-result
